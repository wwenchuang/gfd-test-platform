{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "标准用例文档 v1",
  "description": "交换层校验 ID 唯一、步骤总数和 Excel 可表示字符。version 为本工作集修订号，source 可绑定不可变平台版本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "source",
          "title",
          "risk",
          "precondition",
          "steps",
          "expected",
          "cleanup",
          "layer",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "risk": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "precondition": {
            "type": "string",
            "minLength": 0,
            "maxLength": 30000
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30000,
              "pattern": "\\S"
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "cleanup": {
            "type": "string",
            "minLength": 0,
            "maxLength": 30000
          },
          "layer": {
            "enum": [
              "api",
              "ui",
              "manual"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "pending_review"
            ]
          }
        }
      }
    }
  }
}
