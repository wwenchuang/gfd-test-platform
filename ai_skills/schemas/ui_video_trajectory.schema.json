{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "states",
    "events",
    "checks",
    "uncertainties",
    "multiple_scenarios"
  ],
  "properties": {
    "states": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_id",
          "first_frame",
          "last_frame",
          "kind",
          "description"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "maxLength": 80
          },
          "first_frame": {
            "type": "string",
            "maxLength": 80
          },
          "last_frame": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "page",
              "input",
              "wait",
              "transition"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "target",
          "value",
          "frame_refs",
          "observation",
          "uncertainties",
          "trigger_frame",
          "trigger_kind",
          "page_before",
          "page_after",
          "continuation_of",
          "edit_boundary",
          "outcome"
        ],
        "properties": {
          "action": {
            "enum": [
              "aiTap",
              "aiInput",
              "aiScroll",
              "aiAssert",
              "aiWaitFor"
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 2000
          },
          "value": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 0
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "direction",
                  "scrollType"
                ],
                "properties": {
                  "direction": {
                    "enum": [
                      "up",
                      "down",
                      "left",
                      "right"
                    ]
                  },
                  "scrollType": {
                    "enum": [
                      "singleAction"
                    ]
                  }
                }
              }
            ]
          },
          "frame_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "observation": {
            "type": "string",
            "maxLength": 2000
          },
          "uncertainties": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "trigger_frame": {
            "type": "string",
            "maxLength": 80
          },
          "trigger_kind": {
            "enum": [
              "touch",
              "pressed_control",
              "navigation",
              "edit",
              "automatic",
              "uncertain"
            ]
          },
          "page_before": {
            "type": "string",
            "maxLength": 2000
          },
          "page_after": {
            "type": "string",
            "maxLength": 2000
          },
          "continuation_of": {
            "type": "string",
            "maxLength": 100
          },
          "edit_boundary": {
            "enum": [
              "none",
              "submission",
              "field_change",
              "navigation"
            ]
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frame_refs",
              "observation"
            ],
            "properties": {
              "frame_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "observation": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "status",
          "frame_refs",
          "question"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "enum": [
              "confirmed",
              "needs_review"
            ]
          },
          "frame_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "question": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "multiple_scenarios": {
      "type": "boolean"
    },
    "revisit": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first_frame",
          "last_frame",
          "question"
        ],
        "properties": {
          "first_frame": {
            "type": "string",
            "maxLength": 80
          },
          "last_frame": {
            "type": "string",
            "maxLength": 80
          },
          "question": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
