{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events",
    "uncertainties",
    "multiple_scenarios"
  ],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "target",
          "value",
          "frame_refs",
          "observation"
        ],
        "properties": {
          "action": {
            "enum": [
              "aiTap",
              "aiInput",
              "aiScroll",
              "aiWaitFor",
              "aiAssert"
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 2000
          },
          "value": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "direction": {
                    "enum": [
                      "down",
                      "up",
                      "right",
                      "left"
                    ]
                  },
                  "distance": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scrollType": {
                    "enum": [
                      "singleAction",
                      "scrollToBottom",
                      "scrollToTop",
                      "scrollToRight",
                      "scrollToLeft"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "scrollType"
                      ],
                      "properties": {
                        "scrollType": {
                          "enum": [
                            "scrollToBottom",
                            "scrollToTop",
                            "scrollToRight",
                            "scrollToLeft"
                          ]
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "direction"
                            ]
                          },
                          {
                            "required": [
                              "distance"
                            ]
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          "frame_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "observation": {
            "type": "string",
            "maxLength": 2000
          },
          "uncertainties": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "const": "aiScroll"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "multiple_scenarios": {
      "type": "boolean"
    },
    "coverage_resolutions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_anchor_ids",
          "resolution",
          "reviewed_event_index",
          "evidence"
        ],
        "properties": {
          "source_anchor_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "resolution": {
            "enum": [
              "same_interaction",
              "same_interaction_with_action_correction",
              "same_return_gesture"
            ]
          },
          "reviewed_event_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 49
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before_state",
              "interaction",
              "after_state",
              "why_not_separate_actions",
              "before_frame",
              "interaction_frame",
              "after_frame",
              "examined_frame_refs"
            ],
            "properties": {
              "before_state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "interaction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "after_state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "why_not_separate_actions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "before_frame": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "interaction_frame": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "after_frame": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "examined_frame_refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        }
      }
    }
  }
}
