{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["conclusion", "bottleneck_category", "evidence", "recommendations", "next_run", "confidence"],
  "additionalProperties": false,
  "properties": {
    "conclusion": {"type": "string"},
    "bottleneck_category": {"type": "string", "enum": ["no_bottleneck", "target_service", "network", "load_agent", "test_data", "mixed", "insufficient_evidence"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "domain", "service_key", "intent", "action_code", "fact_ids", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "priority": {"type": "string", "enum": ["high", "medium", "low"]},
          "domain": {"type": "string"},
          "service_key": {"type": ["string", "null"]},
          "intent": {"type": "string", "enum": ["confirm_component", "collect_evidence", "inspect"]},
          "action_code": {"type": "string"},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "next_run": {
      "type": "object",
      "required": ["load_model", "target", "duration_seconds", "agent_suggestion"],
      "additionalProperties": false,
      "properties": {
        "load_model": {"type": "string", "enum": ["constant-vus", "ramping-vus", "constant-arrival-rate", "ramping-arrival-rate"]},
        "target": {"type": "number"},
        "duration_seconds": {"type": "integer"},
        "agent_suggestion": {"type": "string"},
        "workload": {"type": "object", "description": "完整负载配置，遵循平台四种模型编译器契约；阶梯包含起始压力和全部阶段。"}
      }
    },
    "confidence": {
      "type": "object",
      "required": ["level", "reason"],
      "additionalProperties": false,
      "properties": {
        "level": {"type": "string", "enum": ["high", "medium", "low"]},
        "reason": {"type": "string"}
      }
    }
  }
}
