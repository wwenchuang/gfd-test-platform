{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events",
    "uncertainties",
    "multiple_scenarios"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "events": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "target",
          "value",
          "start_ms",
          "end_ms",
          "frame_refs",
          "observation",
          "evidence_kind",
          "uncertainties"
        ],
        "properties": {
          "action": {
            "enum": [
              "aiTap",
              "aiInput",
              "aiScroll",
              "aiWaitFor",
              "aiAssert"
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 2000
          },
          "value": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "direction": {
                    "enum": [
                      "down",
                      "up",
                      "right",
                      "left"
                    ]
                  },
                  "distance": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scrollType": {
                    "enum": [
                      "singleAction",
                      "scrollToBottom",
                      "scrollToTop",
                      "scrollToRight",
                      "scrollToLeft"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "scrollType"
                      ],
                      "properties": {
                        "scrollType": {
                          "enum": [
                            "scrollToBottom",
                            "scrollToTop",
                            "scrollToRight",
                            "scrollToLeft"
                          ]
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "direction"
                            ]
                          },
                          {
                            "required": [
                              "distance"
                            ]
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "frame_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "observation": {
            "type": "string",
            "maxLength": 2000
          },
          "evidence_kind": {
            "enum": [
              "observed",
              "inferred"
            ]
          },
          "uncertainties": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation",
              "frame_refs"
            ],
            "properties": {
              "observation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "frame_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "selection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reusable_expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "const": "aiScroll"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "multiple_scenarios": {
      "type": "boolean"
    }
  }
}
