{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api_case_generation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint_id", "case"],
        "properties": {
          "endpoint_id": {"type": "string", "minLength": 1, "maxLength": 36},
          "case": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name", "purpose", "priority", "request", "data_rows",
              "assertions", "extractions", "dependencies", "processing"
            ],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 300},
              "purpose": {"type": "string", "minLength": 1, "maxLength": 10000},
              "priority": {"enum": ["P0", "P1", "P2", "P3"]},
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "path", "service", "path_params", "query", "headers", "cookies", "body"],
                "properties": {
                  "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
                  "path": {"type": "string", "minLength": 1, "maxLength": 4000},
                  "service": {"type": "string", "minLength": 1, "maxLength": 200},
                  "path_params": {"type": "object"},
                  "query": {"type": "object"},
                  "headers": {"type": "object"},
                  "cookies": {"type": "object"},
                  "body": {}
                }
              },
              "data_rows": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "values", "enabled"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1, "maxLength": 200},
                    "values": {"type": "object"},
                    "enabled": {"type": "boolean"}
                  }
                }
              },
              "assertions": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "operator", "enabled"],
                  "properties": {
                    "type": {"enum": ["status_code", "json_path", "header", "response_time", "schema"]},
                    "operator": {"enum": ["equals", "not_equals", "contains", "not_contains", "exists", "not_exists", "greater_than", "less_than", "matches", "in"]},
                    "expected": {},
                    "path": {"type": "string", "maxLength": 1000},
                    "name": {"type": "string", "maxLength": 1000},
                    "timeout_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
                    "enabled": {"type": "boolean"}
                  }
                }
              },
              "extractions": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["target", "type", "required"],
                  "properties": {
                    "target": {"type": "string", "minLength": 1, "maxLength": 200},
                    "type": {"enum": ["json_path", "header", "cookie", "status_code"]},
                    "path": {"type": "string", "maxLength": 1000},
                    "name": {"type": "string", "maxLength": 1000},
                    "required": {"type": "boolean"},
                    "default": {}
                  }
                }
              },
              "dependencies": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["case_version_id", "required", "exports"],
                  "properties": {
                    "case_version_id": {"type": "string", "minLength": 1, "maxLength": 100},
                    "required": {"type": "boolean"},
                    "exports": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 200}}
                  }
                }
              },
              "processing": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pre", "post"],
                "properties": {
                  "pre": {"$ref": "#/$defs/processingActions"},
                  "post": {"$ref": "#/$defs/processingActions"}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "processingActions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {"enum": ["set_variable", "copy_variable", "remove_variable", "json_encode", "json_decode"]},
          "name": {"type": "string", "maxLength": 200},
          "value": {},
          "source": {"type": "string", "maxLength": 200},
          "target": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}
