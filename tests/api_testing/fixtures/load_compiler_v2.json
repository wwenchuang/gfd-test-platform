tep.sleep_ms > 0) sleep(step.sleep_ms / 1000);\n  return stepOk;\n}\n\nfunction step_detail(state, data) {\n  const step = {\"action\":\"http_request\",\"assertions\":[{\"enabled\":true,\"expected\":200,\"operator\":\"equals\",\"type\":\"status_code\"}],\"extractions\":[],\"id\":\"detail\",\"name\":\"\u67e5\u770b\u8be6\u60c5\",\"request\":{\"body\":null,\"cookies\":{},\"headers\":{\"Authorization\":{\"$extract\":\"access_token\"}},\"method\":\"GET\",\"path\":\"/models/{{model_id}}\",\"path_params\":{},\"query\":{},\"service\":\"default\"},\"scope\":\"iteration\",\"side_effect\":\"readonly\",\"sleep_ms\":0};\n  const request = resolveValue(step.request, state, data);\n  const baseUrl = serviceBaseUrl(request.service);\n  const pathVariables = Object.assign({}, state, request.path_params || {});\n  const url = baseUrl + resolveTemplate(request.path, pathVariables, true) + encodeQuery(request.query);\n  const body = request.body === null ? null : JSON.stringify(request.body);\n  const params = { headers: Object.assign({}, defaultHeaders, request.headers), cookies: request.cookies, tags: { name: \"detail \u67e5\u770b\u8be6\u60c5\", step_id: \"detail\" } };\n  const response = http.request(request.method, url, body, params);\n  const stepOk = check(response, {\"HTTP\u72b6\u6001\u7b26\u5408\u9884\u671f\": (item) => item.status === 200});\n  applyExtractions(step.extractions, response, state);\n  if (step.sleep_ms > 0) sleep(step.sleep_ms / 1000);\n  return stepOk;\n}\n\nexport function setup() {\n  const state = JSON.parse(__ENV[\"LOAD_SETUP_JSON\"] || \"{}\");\n  const data = {};\n  \n  return { state };\n}\n\nexport default function(data) {\n  const elapsedSeconds = (Date.now() - exec.scenario.startTime) / 1000;\n  let phaseEnd = 0;\n  let phase = \"__load_stage_outside\";\n  for (let i = 0; i < loadStageDurations.length; i++) {\n    phaseEnd += loadStageDurations[i];\n    if (elapsedSeconds < phaseEnd) { phase = \"__load_stage_\" + i; break; }\n  }\n  if (loadStageDura