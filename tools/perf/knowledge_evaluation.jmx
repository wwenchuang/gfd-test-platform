<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Knowledge evaluation report" enabled="true">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Readers" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(users,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Sample or time budget" enabled="true">
          <stringProp name="WhileController.condition"><![CDATA[${__groovy((vars.getObject('samples') ?: 0) < props.getProperty('sample_limit').toInteger() && (props.get('phase_t0') == null || System.currentTimeMillis() + 1000L < (long) props.get('phase_t0') + props.getProperty('budget_ms').toLong()))}]]></stringProp>
        </WhileController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="knowledge-evaluation" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
            <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp>
            <stringProp name="HTTPSampler.port">${__P(port)}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/api/platform/requirement-design/knowledge/evaluation</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <stringProp name="HTTPSampler.connect_timeout">3000</stringProp><stringProp name="HTTPSampler.response_timeout">5000</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Record stage start and attach private session" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp>
              <stringProp name="script"><![CDATA[
if (!vars.get('sessionToken')) {
    synchronized (props) {
        if (props.get('phase_t0') == null) {
            def secret = new File(props.getProperty('token_file')).getText('UTF-8').trim()
            props.put('privateSession', secret)
            def now = System.currentTimeMillis()
            new File(props.getProperty('marker')).setText(now.toString(), 'UTF-8')
            props.put('phase_t0', now)
        }
        vars.put('sessionToken', props.get('privateSession'))
    }
}
vars.putObject('samples', (vars.getObject('samples') ?: 0) + 1)
]]></stringProp>
            </JSR223PreProcessor><hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Platform session" enabled="true">
              <collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${sessionToken}</stringProp>
              </elementProp></collectionProp>
            </HeaderManager><hashTree/>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="1 second per reader" enabled="true">
              <stringProp name="ConstantTimer.delay">1000</stringProp>
            </ConstantTimer><hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP and frozen business contract" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp>
              <stringProp name="script"><![CDATA[
String failure = null
if (prev.getResponseCode() != '200') {
    failure = 'http_status'
} else {
    try {
        def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
        def expected = props.getProperty('expected_questions').toInteger()
        def metrics = [recall_at_5:[16,20], citation_support:[16,20], unknown_refusal:[5,5], access_refusal:[5,5], zero_leak:[5,5]]
        if (body.ok != true) {
            failure = 'business_ok'
        } else if (!(body.report?.questions instanceof List) || body.report.questions.size() != expected) {
            failure = 'question_count'
        } else if (!['keyword','vector'].every { method ->
            metrics.every { name, target ->
                def value = body.report.methods?.get(method)?.metrics?.get(name)
                value?.count == target[0] && value?.total == target[1]
            }
        }) {
            failure = 'method_metrics'
        }
    } catch (Exception ignored) {
        failure = 'invalid_report'
    }
}
if (failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure)
}
]]></stringProp>
            </JSR223Assertion><hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
