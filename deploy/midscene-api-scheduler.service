[Unit]
Description=Midscene API Testing Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=midscene
Group=midscene
WorkingDirectory=/opt/midscene-task-platform
Environment=MIDSCENE_ENV_FILE=/opt/midscene.env
ExecStart=/opt/midscene-task-platform/.venv/bin/python -m task_server.api_testing.scheduler
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
