# 平台地址。公网必须使用 HTTPS；受控私网/VPN 的 HTTP 需额外开启下方开关。
PLATFORM_URL=https://test-platform.example.com
ALLOW_INSECURE_PRIVATE_AGENT_TRANSPORT=0

# 一次性令牌只在首次注册时填写。install.sh 注册成功后会自动清空。
ENROLL_TOKEN=

# Agent 本机硬上限。平台软上限和校准容量只会进一步收紧，不能突破这些值。
AGENT_MAX_PROCESSES=1
AGENT_MAX_VUS=500
AGENT_MAX_ITERATIONS_PER_SECOND=2000
AGENT_MAX_DURATION_SECONDS=1800

# Docker 资源保护。建议先保守配置，完成节点校准后再逐步调高。
LOAD_AGENT_CPU_LIMIT=2.0
LOAD_AGENT_MEMORY_LIMIT=2g
LOAD_AGENT_PIDS_LIMIT=256

# 固定镜像版本；升级时通过 LOAD_AGENT_IMAGE 指定新版本。
LOAD_AGENT_IMAGE=midscene-load-agent:0.1.2
K6_IMAGE=grafana/k6:0.52.0
PYTHON_IMAGE=python:3.12.5-slim-bookworm

# 可选镜像候选，使用英文逗号分隔。第一个源失败时 install/upgrade 会继续尝试下一个。
K6_IMAGE_CANDIDATES=grafana/k6:0.52.0
PYTHON_IMAGE_CANDIDATES=python:3.12.5-slim-bookworm

# 固定运行参数。
AGENT_DATA_DIR=/var/lib/midscene-load-agent
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_POLL_INTERVAL_SECONDS=2
AGENT_HEARTBEAT_INTERVAL_SECONDS=10
K6_STOP_GRACE_SECONDS=10
