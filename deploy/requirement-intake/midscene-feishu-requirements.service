[Unit]
Description=Import test-ready Feishu Project requirements into the workbench
After=network-online.target midscene-task.service
Wants=network-online.target

[Service]
Type=oneshot
User=midscene
Group=midscene
WorkingDirectory=/opt/midscene-task-platform
Environment=MIDSCENE_ENV_FILE=/opt/midscene.env
EnvironmentFile=/etc/midscene-feishu-requirements.env
ExecStart=/opt/midscene-task-platform/.venv/bin/python -m task_server.services.feishu_requirement_sync
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
