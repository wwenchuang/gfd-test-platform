[Unit]
Description=Daily ZhiXiaoBai 3D Android baseline regression
After=network-online.target midscene-task.service
Wants=network-online.target
Requisite=midscene-task.service

[Service]
Type=oneshot
User=midscene
Group=midscene
WorkingDirectory=/opt/midscene-task-platform
Environment=PYTHONPATH=/opt/midscene-task-platform
Environment=MIDSCENE_ENV_FILE=/opt/midscene.env
EnvironmentFile=/opt/midscene-3d-daily/current/owner.env
ExecStart=/opt/midscene-task-platform/.venv/bin/python /opt/midscene-3d-daily/current/run.py --run
StateDirectory=midscene-3d-daily
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=16h
